# =============================================================================
# EchoTrace AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: The SECRET_KEY below is a DEVELOPMENT-ONLY placeholder.
# In production/staging, you MUST set SECRET_KEY to a strong random
# value at least 32 characters long.
# =============================================================================

# ── General ─────────────────────────────────────────────────────────────────
PROJECT_NAME=EchoTrace AI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Backend (FastAPI) ───────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# REQUIRED in production — generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# ── Authentication ──────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
AUTH_USE_COOKIES=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
PASSWORD_RESET_URL=http://localhost:3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=echotrace
POSTGRES_PASSWORD=echotrace_secret
POSTGRES_DB=echotrace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_SYNC_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=echotrace_neo4j
NEO4J_DATABASE=neo4j

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
