# =============================================================================
# EchoTrace AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# IMPORTANT: The SECRET_KEY below is a DEVELOPMENT-ONLY placeholder.
# In production/staging, you MUST set SECRET_KEY to a strong random
# value at least 32 characters long.
# =============================================================================

# ── General ─────────────────────────────────────────────────────────────────
PROJECT_NAME=EchoTrace AI
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Backend (FastAPI) ───────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# REQUIRED in production — generate with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars

# ── Authentication ──────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24
AUTH_USE_COOKIES=false
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
PASSWORD_RESET_URL=http://localhost:3000

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=echotrace
POSTGRES_PASSWORD=echotrace_secret
POSTGRES_DB=echotrace
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_SYNC_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── Database SSL ─────────────────────────────────────────────────────────────
# Set to "require" for Neon, Supabase, or any SSL-required PostgreSQL.
# Local Docker PostgreSQL should use "disable".
DB_SSL_MODE=disable

# ── Neo4j ───────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=echotrace_neo4j
NEO4J_DATABASE=neo4j

# ── AI / LLM Providers ───────────────────────────────────────────────────────
# AI_PROVIDER must be one of: openai, anthropic, gemini, azure, ollama
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Ollama (optional, local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_S3_PREFIX=evidence

# ── Redis / Workers ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ── Email ────────────────────────────────────────────────────────────────────
# console logs locally; resend sends through HTTPS.
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@echotrace.local
EMAIL_FROM_NAME=EchoTrace AI
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false

# ── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=development
